# Copy to .env.local for local dev; set the same names in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# Form storage: console (dev default) | resend | supabase
FORM_ADAPTER=console
# Resend (email each submission to the campaign)
RESEND_API_KEY=
FORM_TO_EMAIL=
FORM_FROM_EMAIL=
# Supabase (store submissions in a table; service-role key stays server-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
